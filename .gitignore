# ================= MuoniumPlayer 多版本单仓 =================
# 规则对根目录下所有版本工程统一生效，各版本工程内不再单独维护 .gitignore。

# ---- 构建产物 / 本地缓存 ----
build/
# 各版本 buildAll 汇总产物的统一目录（rootProject/dist，由 collectDist 任务写入）
dist/
.gradle/
out/
.idea/
.idea_modules/
*.iml

# ---- 运行时目录（含账号 cookie、缓存音频、崩溃报告，绝不上传）----
run/
logs/
# 开发期 runClient 把 MC 的 config 目录直接生成在 <版本>/<加载器>/ 下的情况
#（里面有 kugou_auth.json 这类登录凭据，绝不入库）
config/
*.log
hs_err_pid*
replay_pid*

# ---- 反编译参考资料（client jar / fabric-api / JDK，约 470 MB，本地生成）----
_mcref/

# ---- 脚本变量未展开产生的误建目录 ----
%SystemDrive%/

# ---- 迁移到单仓前的旧单版本 git 仓库备份（见 README「历史」）----
_legacy-git/

# ---- 系统垃圾 ----
.DS_Store
Thumbs.db

# tools/ 里的 python 脚本被 import 时会留下字节码缓存
__pycache__/
*.pyc

# 本地排障导出的完整错误报告（含日志、账号环境与第三方 jar，绝不上传）
error-report-*/

# Codex 临时上游源码参考（不参与项目构建）
.codex-reference/

# ---- 开发期草稿 / 本地参考资料（不入库）----
# 会话临时脚本、探针结果与备份。注意 memory/ 是要入库的，所以只忽略这几个子目录
/.workbuddy/tmp/
# 酷狗 API 参考实现的两份本地副本（上游 zip 解包 + git clone），仅查阅用
/.workbuddy/kugou-ref/
/.workbuddy/kugou-zip/

# 注释翻译 / 扫描用的一次性脚本与清单（长期保留的正式工具在 tools/ 下）
/1.21.11 recode/*.py
/1.21.11 recode/untranslated_files.txt

# 脚本手滑产生的零字节文件（`-` 是重定向目标写漏；download.html 与 分析对象 同类）
/-
/download.html
/分析对象
