# ================= MuoniumPlayer 多版本单仓 =================
# 规则对根目录下所有版本工程统一生效，各版本工程内不再单独维护 .gitignore。

# ---- 构建产物 / 本地缓存 ----
build/
# 各版本 buildAll 汇总产物的统一目录（rootProject/dist，由 collectDist 任务写入）
dist/
.gradle/
out/
.idea/
.idea_modules/
*.iml

# ---- 运行时目录（含账号 cookie、缓存音频、崩溃报告，绝不上传）----
run/
logs/
# 开发期 runClient 把 MC 的 config 目录直接生成在 <版本>/<加载器>/ 下的情况
#（里面有 kugou_auth.json 这类登录凭据，绝不入库）
config/
# 例外：mpserver-core 的 yun/shan/mpsync/config 是 Java 源码包（MpConfig.java），
# 不是 MC 运行 config —— 曾被上面的规则误伤，clone 后 mpserver-core 编译不过。
!mpserver-core/src/main/java/yun/shan/mpsync/config/
*.log
hs_err_pid*
replay_pid*

# ---- 反编译参考资料（client jar / fabric-api / JDK，约 470 MB，本地生成）----
_mcref/

# ---- 脚本变量未展开产生的误建目录 ----
%SystemDrive%/

# ---- 迁移到单仓前的旧单版本 git 仓库备份（见 README「历史」）----
_legacy-git/
_viperfx-ref/

# ---- 系统垃圾 ----
.DS_Store
Thumbs.db

# tools/ 里的 python 脚本被 import 时会留下字节码缓存
__pycache__/
*.pyc

# 本地排障导出的完整错误报告（含日志、账号环境与第三方 jar，绝不上传）
error-report-*/

# Codex 临时上游源码参考（不参与项目构建）
.codex-reference/

# 会话草稿区：解包上游 api-enhanced zip 供对照参数用，仅查阅、随时可重解包，不参与构建
/.scratch/

# ---- 开发期草稿 / 本地参考资料（不入库）----
# 会话临时脚本、探针结果与备份。注意 memory/ 是要入库的，所以只忽略这几个子目录
/.workbuddy/tmp/
# 酷狗 API 参考实现的两份本地副本（上游 zip 解包 + git clone），仅查阅用
/.workbuddy/kugou-ref/
/.workbuddy/kugou-zip/
# 汽水 API 参考实现的上游 clone（自带 node_modules 与运行日志），仅查阅用
/qishui-api-main/
# 注释翻译用的四版本源码快照（约 3 500 个文件），随时可重新生成，不入库
/src-zh/
# 浏览器自动化调试期留下的会话日志
/.playwright-cli/

# 注释翻译 / 扫描用的一次性脚本与清单（长期保留的正式工具在 tools/ 下）
/1.21.11 recode/*.py
/1.21.11 recode/untranslated_files.txt

# 脚本手滑产生的零字节文件（`-` 是重定向目标写漏；download.html 与 分析对象 同类）
/-
/download.html
/分析对象
/out.txt
/err.txt

# ---- 本地留档但绝不入库的产物 ----
# 发版交付目录：十个加载器 jar + 真机截图，1.1 GB。发布走 MuoniumPlayer-updates 与官网，
# 这里只是本机备着查的副本，进库会把仓库撑爆
/交付/
# buildAll 过程中 gradle 的临时 classes 输出（每棵一份，内容与 build/ 重叠）
/MUSIC.scratchout-*/
# 工具自己写的额度/会话记录目录
/.qoder-credits/

# 开源快照目录（tools/make-opensource.py 生成，发布走开源仓库，不入本库）
/opensource/

# ---- 排查用临时转储（GL 命令 / javap 字节码 / 版本 diff 草稿），用完即弃 ----
/tmp-*.txt
/diff*.txt

# ZCode 工具的本地索引配置
/.zcodeignore

# ZCode 工具的本地状态目录（会话/工作区数据）
/.zcode/

# 编译产物/文件清单/探针等一次性草稿转储，用完即弃
/_*.txt
/.*.txt

# ---- 接口探针转储（含响应体与会话 token，绝不入库）----
# 26.3/qr.json 里有汽水扫码登录 token，pc-test.json / search.json 是后端探针响应。
# 这三个是手测时写在工作区的，跟各版本工程无关，按「文件 + 递归」两条都堵上。
/26.3/*.json
/search.json
/pc-test.json
/qr.json
# 各版本树下同类探针 json（只匹配根层，不误伤 src/main/resources 里的 mod 元数据）
/*/*/qr.json
/*/*/pc-test.json

# ---- 第三方上游源码 clone（自带 .git，参考用，不入本库）----
/IMBlocker/
# 本项目 背景 shader 移植期的上游 clone（AGPL 参考实现，仅查阅）
/_folia_ref/

# ---- buildAll 发布产物的第二份落地目录（与 /dist/ 同质，每份一百多 MB）----
/dist-new/

# 仓库大扫除的回收站：历史遗留垃圾先移进来等确认，确认无误后整个删掉
/_trash/
