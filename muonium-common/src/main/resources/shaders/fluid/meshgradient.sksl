 *
 * SkSL port of AMLL Core's mesh.frag.glsl. Modified in 2026 for Skija
 * RuntimeEffect: the interpolated mesh UV is supplied as localCoord and the
 * 32x32 cover is a child shader.
 */

uniform float time;
uniform float audio;
uniform float alpha;
uniform shader cover;

const float TEX_SIZE = 32.0;
const float INV_255 = 1.0 / 255.0;
const float HALF_INV_255 = 0.5 / 255.0;

float gradientNoise(float2 uv) {
    return fract(52.9829189 * fract(dot(uv, float2(0.06711056, 0.00583715))));
}

half4 main(float2 localCoord) {
    float2 uv = localCoord / TEX_SIZE;
    float dither = INV_255 * gradientNoise(localCoord) - HALF_INV_255;

    float2 centeredUV = uv - float2(0.3);
    float volumeEffect = audio * 0.10;
    float angle = time * 0.2;
    float sinAngle = sin(angle);
    float cosAngle = cos(angle);
    float2 rotatedUV = float2(
        cosAngle * centeredUV.x - sinAngle * centeredUV.y,
        sinAngle * centeredUV.x + cosAngle * centeredUV.y
    ) * max(0.35, 1.0 - volumeEffect) + float2(0.5);

    float3 rgb = float3(cover.eval(rotatedUV * TEX_SIZE).rgb);
    rgb *= alpha;
    rgb += float3(dither);

    float dist = distance(uv, float2(0.5));
    float vignette = smoothstep(0.8, 0.3, dist);
    rgb *= 0.6 + vignette * 0.4;
    return half4(rgb, alpha);
}

